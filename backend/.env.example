# Copy to backend/.env and fill in. Never commit backend/.env.

# Required: long random string used to sign session cookies.
# Generate one with:  node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
JWT_SECRET=

# --- Switchable AI providers (farm-chat) ---
# Provider order defaults to Groq, then Gemini. Keys are optional, but at least
# one configured provider key is required for AI explanations.
AI_PROVIDER_PRIMARY=groq
AI_PROVIDER_FALLBACK=gemini
GROQ_API_KEY=
GEMINI_API_KEY=
ANTHROPIC_API_KEY=

# Change model IDs without a code deployment. Provider request timeout defaults to 15 seconds.
GROQ_MODEL=llama-3.1-8b-instant
GEMINI_MODEL=gemini-3.5-flash
ANTHROPIC_MODEL=claude-haiku-5-5
# AI_TIMEOUT_MS=15000

# Optional: same Google OAuth Web Client ID used by the frontend VITE_GOOGLE_CLIENT_ID.
# Required on the backend deployment to enable Google sign-in.
GOOGLE_CLIENT_ID=

# Optional settings (defaults shown)
# PORT=3001
# DATABASE_PATH=src/kagochi.db
# CORS_ORIGINS=http://localhost:5173
# SESSION_HOURS=8
# ALLOW_REGISTRATION=false
# COOKIE_SECURE=false          # set true when served over HTTPS (default true when NODE_ENV=production)
# FRONTEND_DIST=../frontend/dist   # serve the built frontend from the backend (single-origin deployment)
